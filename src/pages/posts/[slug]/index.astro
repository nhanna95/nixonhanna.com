---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTagDescriptions } from '../../../lib/data';
import { formatDate, isoDate, readingTimeMinutes, getSortedPosts, postUrl } from '../../../lib/site';

export async function getStaticPaths() {
    const posts = await getSortedPosts();
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, subtitle, date, updated, tags, substack, lesswrong, hide_feedback } = post.data;
const readTime = readingTimeMinutes(post.body ?? '');
const tagDescriptions = getTagDescriptions();
---

<BaseLayout title={title} path={postUrl(post)} articleDate={date}>
    <article class="entry" aria-labelledby="entry-heading">
        <header class="entry-head">
            <h1 class="h1" id="entry-heading">{title}</h1>
            {subtitle && <p class="entry-subtitle">{subtitle}</p>}
            <div class="entry-meta">
                <div class="entry-dates">
                    <time datetime={isoDate(date)}>{formatDate(date)}</time>
                    <span class="entry-date-separator">·</span>
                    <span class="entry-read-time">{readTime} min read</span>
                    {updated && (
                        <>
                            <span class="entry-date-separator">·</span>
                            <span class="entry-updated">Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time></span>
                        </>
                    )}
                </div>
                {tags.length > 0 && (
                    <>
                        <ul class="taglist">
                            {tags.map((tag) => (
                                <li><a href={`/blog.html#tag-${tag.toLowerCase()}`} class="tag-link"
                                        data-tooltip={tagDescriptions[tag] || undefined}
                                        data-tag={tag}>{tag}</a></li>
                            ))}
                        </ul>
                        <script is:inline>
                            // Normalize tag links to match JavaScript regex: /[^a-z0-9]+/g -> '-'
                            (function () {
                                const tagLinks = document.querySelectorAll('.tag-link[data-tag]');
                                tagLinks.forEach(link => {
                                    const tag = link.getAttribute('data-tag');
                                    const normalized = tag.toLowerCase().replace(/[^a-z0-9]+/g, '-');
                                    const href = link.getAttribute('href').split('#')[0] + '#tag-' + normalized;
                                    link.setAttribute('href', href);
                                });
                            })();
                        </script>
                    </>
                )}
            </div>
        </header>

        {substack && (
            <div class="callout">
                <p>This post is also available on <a href={substack} target="_blank"
                        rel="noopener noreferrer">Substack</a>.</p>
            </div>
        )}

        {lesswrong && (
            <div class="callout">
                <p>This post is also available on <a href={lesswrong} target="_blank"
                        rel="noopener noreferrer">LessWrong</a>.</p>
            </div>
        )}

        <Content />

        {!hide_feedback && (
            <p class="post-feedback">Feel free to give me any <a href="/feedback" title="Anonymous feedback" data-turbo="false">anonymous feedback</a> you may have!</p>
        )}

        <hr class="rule">
        <p class="post-nav"><a href="/blog.html">← Back to Blog</a></p>
    </article>
</BaseLayout>
