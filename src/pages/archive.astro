---
import PageLayout from '../layouts/PageLayout.astro';
import { archiveItems } from '../data/archive';
---

<PageLayout title="Archive" path="/archive.html">
    <p class="lead">Various random projects of mine.</p>

    <ul class="archive-list">
        {archiveItems.map((item) => (
            <li>
                <div class="archive-item-top">
                    <a class="archive-title" href={item.href}>{item.title}</a>
                    <time class="archive-date" datetime={item.date}>{item.label}</time>
                </div>
                <p set:html={item.blurb} />
            </li>
        ))}
    </ul>
</PageLayout>
