---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUILD_V, formatDate, getSortedPosts, lastChanged, postUrl } from '../lib/site';

const RECENT_POSTS = 5;
const posts = await getSortedPosts();
const recentPosts = posts.slice(0, RECENT_POSTS);
const morePosts = posts.length - recentPosts.length;
const updated = lastChanged('src/pages/index.astro');

// Clicking the still cycles through these; each one also re-themes the page (see [data-still] in styles.css).
// `film` is the hover credit, "Title (Year), Director"; leave it empty for a frame that isn't from a film.
const STILLS = [
    { key: 'yangyang', src: '/stills/yangyang.jpg', alt: 'Yang-Yang holding a camera up to his face in a photo shop, from Yi Yi', film: 'Yi Yi (2000), Edward Yang' },
    { key: 'balloons', src: '/stills/balloons.jpg', alt: 'Pink heart balloons in front of a red curtain at a wedding hall, from Yi Yi', film: 'Yi Yi (2000), Edward Yang' },
    { key: 'perfectdays', src: '/stills/perfectdays.jpg', alt: 'Hirayama lying on a tatami floor beside a shelf of cassettes, from Perfect Days', film: 'Perfect Days (2023), Wim Wenders' },
    { key: 'record', src: '/stills/record.jpg', alt: 'People browsing crates in a dim basement record store, in black and white, from Perfect Days', film: 'Perfect Days (2023), Wim Wenders' },
];
---

<BaseLayout tabTitle="Hi, I'm Nixon!" path="/">
    <div>
        <h1 class="h1">Hello, I'm <a class="h1-name" href="https://letterboxd.com/noxinh/" target="_blank" rel="noopener">Nixon</a>!</h1>

        {/* Hover (or tap) the quote and it dissolves into the aside; both sit in one grid cell so they wrap identically. */}
        <div class="epigraph-wrap">
            <p class="epigraph" tabindex="0"><em>&ldquo;Know all the theories, master all the techniques, but as you touch a human soul, be just another human soul.&rdquo;</em></p>
            <p class="epigraph-note"><em>Yes, I know Carl Jung never actually said this. I like the saying, though, so I included it anyway.</em></p>
        </div>

        <h2 class="h2"><a class="h2-quiet" href="https://letterboxd.com/noxinh/" target="_blank" rel="noopener">Who</a></h2>
        <p>Someone who's incredibly interested in all aspects of the human condition.</p>

        <figure class="still">
            <button type="button" class="still-cycle" aria-label="Show a different photo" data-stills={JSON.stringify(STILLS.map((s) => ({ ...s, src: `${s.src}?v=${BUILD_V}` })))} data-film={STILLS[0].film || undefined}>
                <img src={`${STILLS[0].src}?v=${BUILD_V}`} width="1600" height="900" alt={STILLS[0].alt} decoding="async">
                <span class="still-film" aria-hidden="true"></span>
            </button>
        </figure>
        <script is:inline>
            // Match the still to the theme remembered for this visit.
            (function () {
                try {
                    var key = sessionStorage.getItem('still');
                    if (!key) return;
                    var btn = document.querySelector('.still-cycle');
                    var stills = JSON.parse(btn.getAttribute('data-stills'));
                    for (var i = 1; i < stills.length; i++) {
                        if (stills[i].key === key) {
                            var img = btn.querySelector('img');
                            img.src = stills[i].src;
                            img.alt = stills[i].alt;
                            btn.setAttribute('data-index', String(i));
                            if (stills[i].film) btn.setAttribute('data-film', stills[i].film);
                            else btn.removeAttribute('data-film');
                            return;
                        }
                    }
                } catch (e) { }
            })();
        </script>

        <h2 class="h2"><a class="h2-quiet" href="https://www.linkedin.com/in/nixon-hanna/" target="_blank" rel="noopener">What</a></h2>
        <p>An AI safety field-builder passionate about mitigating catastrophic risk from advanced AI and ensuring that AI goes well for all of humanity. I recently joined <a href="https://bluedot.org/" target="_blank" rel="noopener">BlueDot</a> as a program manager to try to make the <a href="https://bluedot.org/courses/agi-strategy" target="_blank" rel="noopener">AGI Strategy Course</a> the best introduction to AI safety available anywhere! I'm also currently mentoring some amazing individuals through <a href="https://sparai.org/" target="_blank" rel="noopener">SPAR</a> and <a href="https://pathfinder.kairos-project.org/" target="_blank" rel="noopener">Pathfinder</a>.</p>
        <p>I've previously taken part in the <a href="https://generatorresidency.org/" target="_blank" rel="noopener">Generator Residency</a>, helped run <a href="https://aialignment.mit.edu/" target="_blank" rel="noopener">MIT AI Alignment</a>, and was lead organizer for OASIS 7.0, a workshop for top AI safety university group organizers. Before that, I did research on gravitational lensing in clusters of galaxies, worked in surgical robotics for a few years, and coached a competitive math team.</p>
        <p>Outside of my work, I spend most of my time running <a href="http://lsc.mit.edu/" target="_blank" rel="noopener">MIT's student-run movie theater</a>, climbing, and <a href="https://letterboxd.com/noxinh/" target="_blank" rel="noopener">reviewing</a> all the movies I watch. I also love music (mostly soul, jazz, hip-hop, and r&b), physical media, reading, philosophy, stationery, and many other things.</p>
      <p>My three favorite things, though, are movies, tile, and glass blocks.</p>
    </div>

    {/* Filled in by the Worker as it serves this page (worker/now.js); hidden until there's something to show. */}
    <section class="note" id="lately" hidden>
        <h2 class="h2">Most recently…</h2>
        <p class="now-line"></p>
    </section>
    <script is:inline>
        // In `astro dev` (or if the Worker couldn't fill it in), fetch the sentence here instead.
        (function () {
            var section = document.getElementById('lately');
            if (!section || !section.hidden) return;
            fetch('/api/now').then(function (r) { return r.ok ? r.json() : null; }).then(function (data) {
                if (!data || !data.html) return;
                section.querySelector('.now-line').innerHTML = data.html;
                section.hidden = false;
            }).catch(function () { });
        })();
    </script>

    <section class="note">
        <h2 class="h2">If you want to reach out…</h2>
        <p>you can see how to do so on my <a href="/contact">contact page</a>. I'm always happy to chat with new people and would love it if you reached out for any reason! You can also <a href="/feedback" data-turbo="false">leave anonymous feedback</a> for me on Admonymous.</p>
    </section>

    <section class="note">
        <h2 class="h2">This site…</h2>
        <p>was originally created with the purpose of starting my <a href="/blog">personal blog</a>.</p>
        <p>I believe writing about things is an incredibly effective way of developing one's own beliefs. Yet, I rarely
            found myself writing about the things I claimed to care about.</p>
        <p>So now I have this blog as a place to more often write about the things I'm thinking about. Here are some of my recent posts, if you're interested:</p>
        <ul class="recent-list">
            {recentPosts.map((post) => (
                <li><a href={postUrl(post)}>{post.data.title}</a> <span class="recent-date">({formatDate(post.data.date)})</span></li>
            ))}
        </ul>
        {morePosts > 0 && <p>You can find the rest of them on the <a href="/blog">blog page</a> of this site.</p>}

        <p>This site also includes an <a href="/archive">archive</a> of various random projects of mine.</p>
    </section>

    <section class="note">
        <h2 class="h2">You can also find me on...</h2>
        <ul class="link-list">
            <li><a href="https://www.linkedin.com/in/nixon-hanna/" target="_blank" rel="noopener">LinkedIn</a></li>
            <li><a href="https://substack.com/@noxin" target="_blank" rel="noopener">Substack</a></li>
            <li><a href="https://letterboxd.com/noxinh/" target="_blank" rel="noopener">Letterboxd</a></li>
            <li><a href="https://www.goodreads.com/user/show/173095954-nixon-hanna" target="_blank" rel="noopener">Goodreads</a></li>
            <li><a href="https://www.instagram.com/nixonh_/" target="_blank" rel="noopener">Instagram</a></li>
            <li><a href="https://curius.app/nixon-hanna" target="_blank" rel="noopener">Curius</a></li>
            <li><a href="https://open.spotify.com/user/nixonhanna95" target="_blank" rel="noopener">Spotify</a></li>
        </ul>
    </section>

    <section class="note">
        <h2 class="h2">Before you go…</h2>
        <p>I'd love to hear any feedback or suggestions for this site. You can <a href="/feedback" data-turbo="false">leave them anonymously</a> or <a href="/contact">get in touch</a> directly.</p>
        <p>And finally, I ask that you find one small way to brighten your own day, or someone else's, today.</p>
    </section>

    <p class="last-updated"><em>Last updated: {formatDate(updated)}</em></p>

</BaseLayout>
