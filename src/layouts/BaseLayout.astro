---
import '../styles/tailwind.css';
import { SITE_DESCRIPTION, SITE_URL, BUILD_V, IS_CANONICAL_HOST, absoluteUrl } from '../lib/site';

interface Props {
    title?: string;
    description?: string;
    /** Page URL path, e.g. '/', '/blog.html', '/posts/welcome/' — used for og:url and nav active state. */
    path: string;
    /** Set for blog posts: renders og:type=article with published_time. */
    articleDate?: Date;
    mainAriaLabelledby?: string;
    /** Extra way-back link shown next to "← hello" (e.g. blog posts → the blog index). */
    backLink?: { href: string; label: string };
}

const { title, description, path, articleDate, mainAriaLabelledby, backLink } = Astro.props;
const fullTitle = title ? `${title} — Nixon Hanna` : 'Nixon Hanna';
const ogDesc = description ?? SITE_DESCRIPTION;
// The name in the header goes home. Built pages link to the absolute SITE_URL (nixonhanna.com, or nixon.fyi on
// the preview build) because the vanity hosts serve other pages at "/"; in dev that would jump to the live site.
const homeHref = import.meta.env.DEV ? '/' : `${SITE_URL}/`;

---

<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <!-- Favicon for browsers and Google Search -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/monogram.png" type="image/png" />
    <link rel="apple-touch-icon" href="/monogram.png" />

    <title>{fullTitle}</title>
    <meta property="og:site_name" content="Nixon Hanna" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:url" content={absoluteUrl(path)} />
    {/* Preview host (nixon.fyi): keep search engines from indexing a duplicate of the site */}
    {!IS_CANONICAL_HOST && <meta name="robots" content="noindex, nofollow" />}
    <!-- 144px og:image: Apple TN3156 — images under 150px wide may show as a small icon in Messages instead of a large preview -->
    <meta property="og:image" content={absoluteUrl('/og-link-icon.png')} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="144" />
    <meta property="og:image:height" content="144" />
    {articleDate ? (
        <>
            <meta property="og:type" content="article" />
            <meta property="article:published_time" content={articleDate.toISOString()} />
        </>
    ) : (
        <meta property="og:type" content="website" />
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content={absoluteUrl('/og-link-icon.png')} />
    <script is:inline>
        // Theme picked from the home-page still, remembered for this visit (see public/site.js).
        (function () {
            try {
                var k = sessionStorage.getItem('still');
                if (k && /^(balloons|perfectdays|record)$/.test(k)) document.documentElement.setAttribute('data-still', k);
            } catch (e) { }
        })();
    </script>
    <style is:inline>
        /* Sync with :root in styles.css: paint the page color before the stylesheet arrives */
        html {
            background-color: #eceedd;
            color: #1b2616;
        }

        html[data-still="balloons"] {
            background-color: #f5e8e4;
            color: #2e1a1a;
        }

        html[data-still="perfectdays"] {
            background-color: #f2e7d0;
            color: #2a2118;
        }

        html[data-still="record"] {
            background-color: #131313;
            color: #e8e8e8;
        }

        /* Home-page still: paint it at its own proportions before styles.css arrives */
        .still img {
            display: block;
            width: 100%;
            height: auto;
        }

    </style>
    <link rel="preload" as="font" type="font/woff2" crossorigin
        href="/fonts/6NUu8FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0K7iN7iQcIfJD58njt0oc7qv8oRcTn.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
        href="/fonts/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7W0Q5nw.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
        href="/fonts/newsreader-latin.woff2" />
    {path === '/' && <link rel="preload" as="image" href={`/stills/yangyang.jpg?v=${BUILD_V}`} fetchpriority="high" />}
    <link rel="stylesheet" href={`/styles.css?v=${BUILD_V}`} />
    <!-- No view-transition meta: default Turbo nav used root snapshots and caused font/headshot glitches. -->
    <meta name="turbo-cache-control" content="no-preview">
    <script is:inline>
        (function () {
            var urls = ['/', '/blog.html', '/contact.html', '/archive.html'];
            function addPrefetch() {
                urls.forEach(function (href) {
                    var link = document.createElement('link');
                    link.rel = 'prefetch';
                    link.href = href;
                    link.as = 'document';
                    document.head.appendChild(link);
                });
            }
            if (document.readyState === 'complete') {
                addPrefetch();
            } else {
                window.addEventListener('load', addPrefetch, { once: true });
            }
        })();
    </script>
    <script is:inline src={`/site.js?v=${BUILD_V}`} defer></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.13/dist/turbo.es2017-umd.js" defer></script>
</head>

<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {/* No site nav: the home page links out to everything. Inner pages get a signature that links home,
        plus a trail back to the blog on posts ("Nixon Hanna / blog"). */}
    {path !== '/' && (
        <header class="site-header" id="site-header" aria-label="Breadcrumb">
            <a class="nav-home nav-sig" href={homeHref}>Nixon Hanna</a>
            {backLink && (
                <>
                    <span class="crumb-sep" aria-hidden="true">/</span>
                    <a class="nav-home" href={backLink.href}>{backLink.label}</a>
                </>
            )}
        </header>
    )}

    <main class="content" id="main-content" tabindex="-1" aria-labelledby={mainAriaLabelledby}>
        <slot />
    </main>

</body>

</html>
