// Cloudflare Workers config: static assets + a small router Worker that keeps
// the Jekyll-era URLs (/about.html, /posts/<slug>/, /meet …) serving exactly
// as GitHub Pages did — no redirect rewriting of .html URLs.
// Deploy with: npm run deploy (runs astro build && wrangler deploy)
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "nixonhanna-com",
    // Preview URL at https://nixonhanna-com.<account>.workers.dev — optionally set to
    // false after the custom domain is live to avoid a duplicate public URL.
    "workers_dev": true,
    "main": "worker/index.js",
    "compatibility_date": "2026-08-29",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        // Exact matches only; worker/index.js handles directory indexes,
        // extensionless fallbacks, and the 404 page.
        "html_handling": "none",
        "not_found_handling": "none"
    },
    "routes": [
        { "pattern": "nixonhanna.com", "custom_domain": true },
        { "pattern": "www.nixonhanna.com", "custom_domain": true }
    ],
    "env": {
        // Preview host: a separate Worker on nixon.fyi. Deploy with `bun run deploy:fyi`
        // (builds with SITE_URL=https://nixon.fyi so canonical/og/sitemap URLs and the
        // noindex meta point at the right host). Requires the nixon.fyi zone on this account.
        "fyi": {
            "name": "nixon-fyi",
            "workers_dev": true,
            "routes": [
                { "pattern": "nixon.fyi", "custom_domain": true },
                { "pattern": "www.nixon.fyi", "custom_domain": true },
                // vanity hosts: root serves the blog / contact page (see hostRoots in worker/index.js)
                { "pattern": "nixon.blog", "custom_domain": true },
                { "pattern": "www.nixon.blog", "custom_domain": true },
                { "pattern": "nixon.contact", "custom_domain": true },
                { "pattern": "www.nixon.contact", "custom_domain": true }
            ]
        }
    }
}
