// Cloudflare Workers config: the built site (dist/) plus worker/index.js, which runs first on
// every request. nixon.fyi serves the site; nixonhanna.com, nixon.blog, nixon.contact and the
// www. hosts redirect to it (the short links /meet and /feedback work on every host).
// Deploy with: bun run deploy (runs astro build && wrangler deploy)
// (The old `nixonhanna-com` Worker that served nixonhanna.com until 2026-09-27 has no domains now.)
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "nixon-fyi",
    // Off: the custom domains are the only way in, so there's no duplicate *.workers.dev copy.
    "workers_dev": false,
    "main": "worker/index.js",
    "compatibility_date": "2026-08-29",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        // The Worker runs before assets so it can redirect every request on the old hosts.
        // It also does directory indexes, extensionless fallbacks and the 404 page itself.
        "run_worker_first": true,
        "html_handling": "none",
        "not_found_handling": "none"
    },
    "routes": [
        { "pattern": "nixon.fyi", "custom_domain": true },
        { "pattern": "www.nixon.fyi", "custom_domain": true },
        { "pattern": "nixonhanna.com", "custom_domain": true },
        { "pattern": "www.nixonhanna.com", "custom_domain": true },
        { "pattern": "nixon.blog", "custom_domain": true },
        { "pattern": "www.nixon.blog", "custom_domain": true },
        { "pattern": "nixon.contact", "custom_domain": true },
        { "pattern": "www.nixon.contact", "custom_domain": true }
    ]
}
